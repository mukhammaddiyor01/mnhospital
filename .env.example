NODE_ENV=development

# Runtime configuration (safe placeholders only; never put live credentials in this file).
CLINIC_TIME_ZONE=Asia/Seoul
CLINIC_CURRENCY=KRW

PORT_API=2001
PORT_BATCH=2003

# Server-only secrets. Supply real values through local `.env` or deployment secrets.
MONGO_DEV=
MONGO_PROD=
SECRET_TOKEN=

# sandbox: real Eximbay test server; disabled: cash only.
# simulated is reserved for isolated automated development tests, never the default.
EXIMBAY_TEST_MODE=sandbox
EXIMBAY_API_BASE=https://api-test.eximbay.com
EXIMBAY_API_KEY=
EXIMBAY_MID=

BASE_URL=http://localhost:2001
CLIENT_URL=http://localhost:2002
OAUTH_REDIRECT_URI=http://localhost:2002/account/oauth/callback
OAUTH_REDIRECT_URIS=http://localhost:2002/account/oauth/callback,http://localhost:3000/account/oauth/callback,http://localhost:3001/account/oauth/callback

# OAuth credentials stay on the API server. Never expose client secrets as NEXT_PUBLIC variables.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=

# Homepage AI assistant. Provider: gemini or openai. All values stay server-only.
AI_CHAT_PROVIDER=gemini
# Enable only after checking that the Google project uses the intended billing tier.
AI_CHAT_ENABLED=false
AI_CHAT_API_KEY=
AI_CHAT_MODEL=
